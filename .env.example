# Spotify Developer App Client ID (PKCE, no client_secret needed)
# Leave blank if you prefer entering Client ID manually on the Login screen (stored in localStorage)
VITE_SPOTIFY_CLIENT_ID=

# Optional override; defaults to `${window.location.origin}/callback`
# Local dev: http://127.0.0.1:3000/callback
# Oracle VPS (sslip.io, replace with your VPS IP using dashes): https://203-0-113-10.sslip.io/callback
VITE_SPOTIFY_REDIRECT_URI=

# Recommended: lock app access to your own Spotify user ID (from GET /v1/me)
VITE_ALLOWED_SPOTIFY_USER_ID=
